# Smart CCTV Configuration
TZ=Asia/Ho_Chi_Minh

# Server
PORT=3001
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=your_custom_jwt_signing_key_here

# Paths
DB_PATH=./data/smart_cctv.db
RECORDINGS_PATH=./data/recordings
SNAPSHOTS_PATH=./data/snapshots

# go2rtc
GO2RTC_URL=http://localhost:1984
GO2RTC_RTSP_URL=rtsp://localhost:8554

# Storage
MAX_STORAGE_GB=100
RETENTION_DAYS=30

# Detection
DETECTION_INTERVAL_MS=3000
DETECTION_ENABLED=true
