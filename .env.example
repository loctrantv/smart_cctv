# Smart CCTV Configuration (Native Node.js + go2rtc Docker)
TZ=Asia/Ho_Chi_Minh

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication
# IMPORTANT: Change ADMIN_PASSWORD and set a strong random JWT_SECRET (at least 32 chars) in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_StrongPassword_2026!
JWT_SECRET=replace_with_a_secure_random_64_char_hex_string_before_deploying

# Comma-separated list of allowed CORS origins (leave empty for same-origin only)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Storage Paths (relative to project root or absolute paths)
DB_PATH=./data/smart_cctv.db
RECORDINGS_PATH=./data/recordings
SNAPSHOTS_PATH=./data/snapshots

# go2rtc (Running in Docker bound to localhost)
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_RTSP_URL=rtsp://127.0.0.1:8554

# Storage Retention Defaults
MAX_STORAGE_GB=100
RETENTION_DAYS=30

# Detection Defaults
DETECTION_INTERVAL_MS=3000
DETECTION_ENABLED=true
